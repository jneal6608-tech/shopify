# =============================================================================
# Dropship Intel — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Everything except NEXT_PUBLIC_* is server-only.
# =============================================================================

# --- Supabase (required in production) ---------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Project → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_POOL_MAX=5

# --- Security (required) -----------------------------------------------------
# 32 random bytes as hex: `openssl rand -hex 32`. Encrypts stored Shopify credentials.
ENCRYPTION_KEY=
# Random string (≥16 chars). Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Local development only --------------------------------------------------
# AUTH_MODE=local uses a fixed dev user against a local Postgres with the dev
# auth shim (see docs/SETUP.md). Refused when NODE_ENV=production.
# AUTH_MODE=local
# LOCAL_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# --- AI (optional — all non-AI features work without it) ---------------------
# console.anthropic.com → API keys. Model is chosen per user in Settings
# (claude-opus-5-5 or claude-sonnet-5-5).
ANTHROPIC_API_KEY=

# --- Data sources (optional) -------------------------------------------------
# Google Trends via SerpApi (serpapi.com). Alternative: CSV import (no key).
SERPAPI_API_KEY=
# YouTube Data API v3 key (Google Cloud Console, restrict to that API).
YOUTUBE_API_KEY=
# Meta Ad Library API user access token with ads_read (identity confirmation required).
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# EU/UK countries to count ads in (non-political ads are only available there).
META_AD_REACHED_COUNTRIES=DE,FR,IT,ES,NL,IE

# --- Shopify (credentials are entered in the app and stored encrypted) -------
# GraphQL Admin API version.
SHOPIFY_API_VERSION=2026-10
